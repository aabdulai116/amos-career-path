{
  "name": "amos-career-path",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "tsx scripts/check-links.ts",
    "sync:problems": "tsx scripts/sync-problems.ts",
    "sync:internships": "python3 worker/ingest.py",
    "test:worker": "python3 -m unittest discover -s worker/tests -t worker",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:loadtest": "tsx scripts/loadtest.ts",
    "test:engine": "make -C engine test",
    "build:engine": "make -C engine wasm"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.2.1",
    "@xyflow/react": "^12.8.6",
    "dagre": "^0.8.5",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.544.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "^8.18.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.53",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "esbuild": "^0.25.12"
  }
}
