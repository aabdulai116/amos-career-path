# Copy to .env.local and fill in. Every one of these is optional: with none
# set, the app runs browser-only with no sign-in button, which is a working
# mode rather than a broken one.

# --- Database -------------------------------------------------------------
# A Neon Postgres connection string. Free tier is plenty.
# https://console.neon.tech -> new project -> copy the pooled connection string
DATABASE_URL=

# --- Auth.js --------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Only needed locally; Vercel sets it for you.
AUTH_URL=http://localhost:3000

# --- Google sign-in -------------------------------------------------------
# https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web
# Authorised redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Microsoft / Outlook sign-in ------------------------------------------
# https://entra.microsoft.com -> App registrations -> New registration
# Supported account types: "Accounts in any organizational directory and
# personal Microsoft accounts" so university and Outlook accounts both work.
# Redirect URI: https://YOUR-DOMAIN/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Leave blank for the multi-tenant default.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
